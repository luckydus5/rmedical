VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-side only — used by scripts/seed.mjs to load demo data.
# This is the SERVICE ROLE key: it bypasses Row-Level Security. Never expose it
# to the browser and never commit a real value. .env is gitignored.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
